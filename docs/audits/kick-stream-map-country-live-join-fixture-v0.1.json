{
  "schemaVersion": "viewloom-kick-stream-map-country-live-join-fixture-v0.1",
  "cases": [
    {
      "id": "stable-id-mapped",
      "input": {
        "liveRows": [{"provider":"kick","channel":{"slug":"Alpha"}}],
        "channelRows": [{"provider":"kick","slug":"alpha","broadcaster_user_id":1001}],
        "reviewedEvidence": [{"provider":"kick","stableKickUserId":1001,"outcome":"accepted","placement":{"state":"mapped","countryCode":"US"}}]
      },
      "expected": {"state":"mapped","reason":"reviewed_country_accepted","stableKickUserId":"1001","countryCode":"US"}
    },
    {
      "id": "slug-only-not-stable-identity",
      "input": {
        "liveRows": [{"provider":"kick","channel":{"slug":"Bravo"}}],
        "channelRows": [{"provider":"kick","slug":"bravo","broadcaster_user_id":null}],
        "reviewedEvidence": [{"provider":"kick","stableKickUserId":"bravo","outcome":"accepted","placement":{"state":"mapped","countryCode":"GB"}}]
      },
      "expected": {"state":"unmapped","reason":"stable_identity_unavailable","stableKickUserId":null,"countryCode":null}
    },
