{
  "schemaVersion": "viewloom-primary-domain-cutover-v2",
  "status": "candidate",
  "primaryOrigin": "https://www.viewloom.net",
  "primaryHost": "www.viewloom.net",
  "redirects": [
    {
      "fromHost": "viewloom.net",
      "toOrigin": "https://www.viewloom.net",
      "status": 301,
      "preservePathAndQuery": false,
      "owner": "spaceship-url-redirect"
    },
    {
      "fromHost": "vl.badjoke-lab.com",
      "toOrigin": "https://www.viewloom.net",
      "status": 301,
      "preservePathAndQuery": true,
      "owner": "cloudflare-pages-middleware"
    }
  ],
  "publicMetadata": {
    "canonical": "https://www.viewloom.net",
    "openGraph": "https://www.viewloom.net",
    "twitterImages": "https://www.viewloom.net",
    "structuredData": "https://www.viewloom.net",
    "sitemap": "https://www.viewloom.net/sitemap.xml",
    "robotsSitemap": "https://www.viewloom.net/sitemap.xml"
  },
  "deployment": {
    "provider": "cloudflare-pages",
    "repoControlledHostRedirect": true,
    "buildNormalizationRequired": true,
    "domainBindingAssumption": "www.viewloom.net is attached to the existing Pages project; viewloom.net remains a registrar-owned redirect to www"
  },
  "independentFromStabilityAudit": true,
  "unchanged": {
    "twitchCollector": true,
    "kickCollector": true,
    "fiveMinuteCadence": true,
    "d1Schema": true,
    "retention": true,
    "categoryStabilityClock": true,
    "publicCategoryUi": true
  }
}
